# Copy to .env and run with:  npm run start:env      (needs Node 20.6+)
# or export the variables in your shell / docker-compose.  Every value is optional.

PORT=3000

# --- accounts ---------------------------------------------------------------
INSTRUCTOR_USERNAME=instructor
INSTRUCTOR_PASSWORD=change-me-please
INSTRUCTOR_NAME=Course Instructor
SEED_DEMO_STUDENTS=false           # optional demo accounts student01..08 / student123 (students normally register themselves)
ALLOW_STUDENT_REGISTRATION=true    # students register on the session page (scan QR / open URL)

# --- security ---------------------------------------------------------------
# JWT_SECRET=long-random-string    # generated and stored in data/.jwt_secret when not set

# --- session URL shown to the lab room ----------------------------------------
# By default the server detects its LAN address (e.g. http://192.168.1.20:3000/s/abc1234).
# Set this if the lab uses a host name / reverse proxy:
# PUBLIC_BASE_URL=http://dbmslab.college.local:3000

# --- lockdown ---------------------------------------------------------------
LOCKDOWN_STRICT=false              # true = assessments only open in the Electron lockdown browser
LOCKDOWN_SECRET=dbms-lab-lockdown-secret   # must match the lockdown browser's LOCKDOWN_SECRET

# --- SQL execution ----------------------------------------------------------
SQL_TIMEOUT_MS=5000                # runaway queries are killed after this time
SQL_WORKERS=2

# --- test cases per generated question ----------------------------------------
VISIBLE_TESTCASES=2
HIDDEN_TESTCASES=3

# --- AI module --------------------------------------------------------------
# none   = built-in offline question/test-case engine (default, no internet or key needed)
# openai = any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, vLLM ...)
AI_PROVIDER=none
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
#   Local LLM with Ollama (Llama / Mistral):
#   AI_PROVIDER=openai
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.1
AI_LLM_FEEDBACK=true               # let the LLM polish the rule-based feedback (never sees hidden data)

# --- metric assumptions (minutes) --------------------------------------------
MANUAL_EVAL_MINUTES=4              # time a teacher needs to mark one SQL answer by hand
REVIEW_MINUTES=1                   # time to review one AI-graded answer
