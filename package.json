{
  "name": "ai-dbms-lab",
  "version": "1.0.0",
  "description": "AI-Enabled Virtual DBMS Laboratory - secure, syllabus-aligned platform for fair, automated SQL assessment",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/smoke.js",
